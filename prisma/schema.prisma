generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── App Auth ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  substackConnection SubstackConnection?
  posts              Post[]
  subscriberEvents   SubscriberEvent[]
  postMetrics        PostMetrics[]
}

// ─── Substack Connection ─────────────────────────────────────────────────────

model SubstackConnection {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  publicationUrl    String
  publicationName   String?
  authorName        String?

  // Encrypted session token — never store raw password
  encryptedToken    String
  tokenExpiresAt    DateTime?

  hasPaidTier       Boolean   @default(false)

  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── Posts ───────────────────────────────────────────────────────────────────

model Post {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  substackPostId  String    @unique
  title           String
  slug            String?
  publishedAt     DateTime
  isPaywalled     Boolean   @default(false)

  metrics         PostMetrics?
  subscriberEvents SubscriberEvent[]
}

// ─── Post Metrics (Feature 1.1 + 1.3 + 1.4) ─────────────────────────────────

model PostMetrics {
  id              String    @id @default(cuid())
  postId          String    @unique
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Raw metrics
  openRate        Float?
  clickRate       Float?
  totalOpens      Int?
  totalClicks     Int?
  totalViews      Int?
  restacks        Int?
  likes           Int?

  // Computed by scoring algorithm (Feature 1.1)
  performanceGrade String?   // A / B / C / D / F
  performanceScore Float?    // 0–100

  // Subscribers gained within 48h of publish (Feature 1.1 + 1.2)
  subscribersGained48h   Int?

  // Free → paid conversions within 72h of publish (Feature 1.4)
  paidConversions72h     Int?

  // Publish timing (Feature 1.3)
  publishDayOfWeek  Int?    // 0=Sun … 6=Sat
  publishHour       Int?    // 0–23

  fetchedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Subscriber Events (Feature 1.2 — Growth Timeline) ───────────────────────

model SubscriberEvent {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventType       SubscriberEventType
  occurredAt      DateTime

  // Subscriber count snapshot at this point in time
  totalCount      Int

  // The post that likely caused this event (nullable — not all spikes are post-driven)
  causativePostId String?
  causativePost   Post?     @relation(fields: [causativePostId], references: [id])

  // For paid conversions
  isPaidUpgrade   Boolean   @default(false)

  createdAt       DateTime  @default(now())

  @@index([userId, occurredAt])
}

enum SubscriberEventType {
  SUBSCRIBE
  UNSUBSCRIBE
  PAID_UPGRADE
  PAID_DOWNGRADE
}
